# Supabase project the native app talks to. `xcodegen generate` substitutes
# these into Info.plist; there is no dotenv loader, so export them into the
# shell before running it — e.g. `set -a && source .env && set +a`. Same
# values as `apps/pwa/.env.example`, from the Supabase dashboard
# (Project Settings → API) or `pnpm supabase start` for the local stack.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
