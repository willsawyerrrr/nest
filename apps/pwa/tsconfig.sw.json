{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    // The worker runs off the window, so it types against `WebWorker` instead of
    // `DOM`. That is why `src/sw.ts` is its own project rather than part of the
    // app's: the two libs declare incompatible globals.
    "lib": ["ES2023", "WebWorker"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/sw.ts", "src/lib/push.ts"]
}
