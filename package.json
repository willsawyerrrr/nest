{
  "name": "nest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "check:migrations": "node scripts/check-migration-versions.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:types": "supabase gen types typescript --local > apps/pwa/src/lib/database.types.ts && prettier --write apps/pwa/src/lib/database.types.ts"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
