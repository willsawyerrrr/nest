{
  "name": "nest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-app.js",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "oxlint",
    "check:migrations": "node scripts/check-migration-versions.js",
    "check:migration-drift": "node scripts/check-migration-drift.js",
    "check:function-drift": "node scripts/check-function-drift.js",
    "vendor:edge": "node scripts/vendor-edge-packages.js",
    "check:vendor-edge": "node scripts/vendor-edge-packages.js --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:types": "node scripts/gen-db-types.js",
    "check:types": "node scripts/gen-db-types.js --check"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "^5.0.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  }
}
