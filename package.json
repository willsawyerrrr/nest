{
  "name": "personal-budget-application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:types": "supabase gen types typescript --local > apps/pwa/src/lib/database.types.ts && prettier --write apps/pwa/src/lib/database.types.ts"
  },
  "devDependencies": {
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "typescript": "~6.0.3"
  }
}
