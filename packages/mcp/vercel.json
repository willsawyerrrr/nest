{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api"
    }
  ],
  "buildCommand": "pnpm run build:vercel"
}
