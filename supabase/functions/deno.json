{
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": false,
    "exclude": ["**/*.md", "_shared/vendor/"]
  },
  "lint": {
    "exclude": ["_shared/vendor/"]
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.115.0",
    "@negrel/webpush": "jsr:@negrel/webpush@0.5.0",
    "@nest/plan": "./_shared/vendor/plan/index.ts",
    "@nest/tax": "./_shared/vendor/tax/index.ts",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/encoding": "jsr:@std/encoding@1.0.11",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2.110.7"
  },
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check **/*.ts",
    // Constructing an Anthropic client reads its configuration from the
    // environment, so the payslip-extract tests need exactly these names: the
    // endpoint (`ANTHROPIC_BASE_URL`), the two credentials the client falls back
    // to (`ANTHROPIC_AUTH_TOKEN`, `ANTHROPIC_WEBHOOK_SIGNING_KEY`), the log level
    // (`ANTHROPIC_LOG`), and the extra request headers
    // (`ANTHROPIC_CUSTOM_HEADERS`). `ANTHROPIC_API_KEY` is absent because the key
    // is always passed to the constructor, so the SDK never reads it. The set is
    // closed — the SDK reads each name individually and never enumerates the
    // environment — and the SDK is pinned and locked, so it moves only with a
    // deliberate upgrade. `--no-prompt` keeps the list authoritative: a read
    // outside it fails the run here exactly as it does in CI, rather than being
    // granted at an interactive prompt.
    "test": "deno test --no-prompt --allow-env=ANTHROPIC_AUTH_TOKEN,ANTHROPIC_BASE_URL,ANTHROPIC_CUSTOM_HEADERS,ANTHROPIC_LOG,ANTHROPIC_WEBHOOK_SIGNING_KEY"
  }
}
